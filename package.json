{
  "name": "@takeal/cusfront-sdk",
  "version": "0.6.8",
  "description": "Typed client for the Takeal end-user API: sign-up and login, wallet, deposits, cards, sessions, notifications, devices, webhook verification.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auth": {
      "types": "./dist/resources/auth.d.ts",
      "import": "./dist/resources/auth.js",
      "require": "./dist/resources/auth.cjs"
    },
    "./deposits": {
      "types": "./dist/resources/deposits.d.ts",
      "import": "./dist/resources/deposits.js",
      "require": "./dist/resources/deposits.cjs"
    },
    "./funding-options": {
      "types": "./dist/resources/funding-options.d.ts",
      "import": "./dist/resources/funding-options.js",
      "require": "./dist/resources/funding-options.cjs"
    },
    "./cards": {
      "types": "./dist/resources/cards.d.ts",
      "import": "./dist/resources/cards.js",
      "require": "./dist/resources/cards.cjs"
    },
    "./balance": {
      "types": "./dist/resources/balance.d.ts",
      "import": "./dist/resources/balance.js",
      "require": "./dist/resources/balance.cjs"
    },
    "./bonus": {
      "types": "./dist/resources/bonus.d.ts",
      "import": "./dist/resources/bonus.js",
      "require": "./dist/resources/bonus.cjs"
    },
    "./debt": {
      "types": "./dist/resources/debt.d.ts",
      "import": "./dist/resources/debt.js",
      "require": "./dist/resources/debt.cjs"
    },
    "./close-requests": {
      "types": "./dist/resources/close-requests.d.ts",
      "import": "./dist/resources/close-requests.js",
      "require": "./dist/resources/close-requests.cjs"
    },
    "./claims": {
      "types": "./dist/resources/claims.d.ts",
      "import": "./dist/resources/claims.js",
      "require": "./dist/resources/claims.cjs"
    },
    "./codes": {
      "types": "./dist/resources/codes.d.ts",
      "import": "./dist/resources/codes.js",
      "require": "./dist/resources/codes.cjs"
    },
    "./referral": {
      "types": "./dist/resources/referral.d.ts",
      "import": "./dist/resources/referral.js",
      "require": "./dist/resources/referral.cjs"
    },
    "./subscription": {
      "types": "./dist/resources/subscription.d.ts",
      "import": "./dist/resources/subscription.js",
      "require": "./dist/resources/subscription.cjs"
    },
    "./branding": {
      "types": "./dist/resources/branding.d.ts",
      "import": "./dist/resources/branding.js",
      "require": "./dist/resources/branding.cjs"
    },
    "./blog": {
      "types": "./dist/resources/blog.d.ts",
      "import": "./dist/resources/blog.js",
      "require": "./dist/resources/blog.cjs"
    },
    "./documents": {
      "types": "./dist/resources/documents.d.ts",
      "import": "./dist/resources/documents.js",
      "require": "./dist/resources/documents.cjs"
    },
    "./history": {
      "types": "./dist/resources/history.d.ts",
      "import": "./dist/resources/history.js",
      "require": "./dist/resources/history.cjs"
    },
    "./consents": {
      "types": "./dist/resources/consents.d.ts",
      "import": "./dist/resources/consents.js",
      "require": "./dist/resources/consents.cjs"
    },
    "./receipts": {
      "types": "./dist/resources/receipts.d.ts",
      "import": "./dist/resources/receipts.js",
      "require": "./dist/resources/receipts.cjs"
    },
    "./support": {
      "types": "./dist/resources/support.d.ts",
      "import": "./dist/resources/support.js",
      "require": "./dist/resources/support.cjs"
    },
    "./attribution": {
      "types": "./dist/resources/attribution.d.ts",
      "import": "./dist/resources/attribution.js",
      "require": "./dist/resources/attribution.cjs"
    },
    "./subscriptions": {
      "types": "./dist/resources/subscriptions.d.ts",
      "import": "./dist/resources/subscriptions.js",
      "require": "./dist/resources/subscriptions.cjs"
    },
    "./wallet": {
      "types": "./dist/resources/wallet.d.ts",
      "import": "./dist/resources/wallet.js",
      "require": "./dist/resources/wallet.cjs"
    },
    "./sessions": {
      "types": "./dist/resources/sessions.d.ts",
      "import": "./dist/resources/sessions.js",
      "require": "./dist/resources/sessions.cjs"
    },
    "./push": {
      "types": "./dist/resources/push.d.ts",
      "import": "./dist/resources/push.js",
      "require": "./dist/resources/push.cjs"
    },
    "./notifications": {
      "types": "./dist/resources/notifications.d.ts",
      "import": "./dist/resources/notifications.js",
      "require": "./dist/resources/notifications.cjs"
    },
    "./devices": {
      "types": "./dist/resources/devices.d.ts",
      "import": "./dist/resources/devices.js",
      "require": "./dist/resources/devices.cjs"
    },
    "./me": {
      "types": "./dist/resources/me.d.ts",
      "import": "./dist/resources/me.js",
      "require": "./dist/resources/me.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "import": "./dist/telegram.js",
      "require": "./dist/telegram.cjs"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js",
      "require": "./dist/analytics.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "refresh-types": "tsx scripts/refresh-types.ts",
    "lint": "eslint --ext .ts,.tsx src scripts && prettier --check . && tsc --noEmit",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=3.22 <4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "takeal",
    "fintech",
    "sdk",
    "client",
    "typescript"
  ],
  "homepage": "https://git.wiseless.net/takeal/cusfront-sdk",
  "bugs": {
    "url": "https://git.wiseless.net/takeal/cusfront-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://git.wiseless.net/takeal/cusfront-sdk.git"
  }
}
