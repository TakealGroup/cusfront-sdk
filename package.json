{
  "name": "@takeal/cusfront-sdk",
  "version": "0.1.0",
  "description": "Typed client for the Takeal end-user API. Auth, deposits, cards, balance, webhook verification.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auth": {
      "types": "./dist/resources/auth.d.ts",
      "import": "./dist/resources/auth.js",
      "require": "./dist/resources/auth.cjs"
    },
    "./deposits": {
      "types": "./dist/resources/deposits.d.ts",
      "import": "./dist/resources/deposits.js",
      "require": "./dist/resources/deposits.cjs"
    },
    "./cards": {
      "types": "./dist/resources/cards.d.ts",
      "import": "./dist/resources/cards.js",
      "require": "./dist/resources/cards.cjs"
    },
    "./balance": {
      "types": "./dist/resources/balance.d.ts",
      "import": "./dist/resources/balance.js",
      "require": "./dist/resources/balance.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "refresh-types": "tsx scripts/refresh-types.ts",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=3.22 <4"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "takeal",
    "fintech",
    "sdk",
    "client",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://git.wiseless.xyz/takeal/cusfront-sdk.git"
  }
}
